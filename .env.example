# Never commit a real secret. Copy this file to .env.local locally.
OPENAI_API_KEY=

# Keep false for the deterministic hackathon demo; opt in to live API calls.
OPENAI_LIVE_MODE=false
OPENAI_MODEL=gpt-5-mini

# Keep mock until the teammate's Supabase repository is wired.
DATA_BACKEND=mock

# Your teammate can add these when the Supabase repository is ready.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
