# Never commit a real secret. Copy this file to .env.local locally.
OPENAI_API_KEY=

# Keep false for the deterministic hackathon demo; opt in to live API calls.
OPENAI_LIVE_MODE=false
OPENAI_MODEL=gpt-5-mini

# Meta coordinates groups; OpenAI continues handling materials and study chat.
# Server-side Meta Model API key from https://dev.meta.ai
META_API_KEY=
META_MODEL=muse-spark-1.3

# Use mock for a zero-setup demo or supabase for persistent data.
DATA_BACKEND=supabase

# Server-side repository credentials. Never expose the service-role key to client code.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dropbox Chooser app key; allow localhost and your deployment domain in the app console.
NEXT_PUBLIC_DROPBOX_APP_KEY=

# Deepgram Voice Agent; server-only key with Member or higher authorization.
DEEPGRAM_API_KEY=
